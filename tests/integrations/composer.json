{
    "name": "useflex/media-studio-integration-tests",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "name": "flex-fields",
            "type": "path",
            "url": "../../../filament-flex-fields"
        },
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "useflex/media-core": "0.1.0",
                    "useflex/media-studio": "0.1.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.6",
        "league/flysystem-aws-s3-v3": "^3.0",
        "spatie/laravel-medialibrary": "^11.0",
        "useflex/media-studio": "0.1.0"
    },
    "require-dev": {
        "janczakb/filament-flex-fields": "@dev",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^12.5",
        "waguilar33/filament-guardian": "^1.15"
    },
    "autoload-dev": {
        "psr-4": {
            "UseFlex\\MediaStudio\\Tests\\": "../"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "description": "Isolated optional Filament, Spatie and S3 integration tests for FLEX Media Studio."
}
